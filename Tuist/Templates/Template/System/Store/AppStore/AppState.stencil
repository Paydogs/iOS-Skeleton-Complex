import Foundation

/// The single source of truth, composed of one substate struct per domain (`LogState`, …).
public struct AppState: StoreState {
    public var isActive: Bool
    public var log: LogState

    public init(isActive: Bool = false,
                log: LogState = LogState()) {
        self.isActive = isActive
        self.log = log
    }

    /// These values will be persisted
    private enum CodingKeys: String, CodingKey {
        case isActive
    }

    /// Controls when the store saves
    public func needsPersistence(comparedTo previous: AppState) -> Bool {
        self.isActive != previous.isActive
    }

    /// Init from stored persisted data
    public init(from decoder: Decoder) throws {
        let container = try decoder.container(keyedBy: CodingKeys.self)
        isActive = (try? container.decode(Bool.self, forKey: .isActive)) ?? false
        log = LogState()
    }
}
