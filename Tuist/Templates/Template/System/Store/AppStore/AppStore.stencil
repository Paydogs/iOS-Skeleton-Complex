import Foundation

/// The concrete, read-only face of the app's state — what every ViewModel and read-only
/// service holds. Owns a `BaseStore` (the state actor) and forwards only `currentState` /
/// `stateStream` / `stream(_:)`; it deliberately exposes **no** `update`. So a holder of
/// `AppStore` can read `AppState` but cannot mutate it — the "state is only mutated by
/// dispatching an Action" rule is enforced by this surface, not by convention.
///
/// The only thing that mutates state is the action-handling layer (`AppActionHandler` and
/// per-domain handlers), which hold the `BaseStore` directly. The `BaseStore` itself is
/// built by a private DI factory, so a reader has no way to resolve it and grab the
/// `update` surface — `AppStore` is the only handle the rest of the app gets.
public final class AppStore: Sendable {
    private let base: BaseStore<AppState>

    public init(baseStore: BaseStore<AppState>) {
        self.base = baseStore
    }

    public var currentState: AppState { get async { await base.currentState } }

    // `stateStream`/`stream` are actor-isolated on `BaseStore`, so the wrappers hop onto
    // the actor — hence `async`.
    public func stateStream() async -> AsyncStream<AppState> { await base.stateStream() }

    public func stream<each Property: Equatable & Sendable>(
        _ paths: repeat KeyPath<AppState, each Property>
    ) async -> AsyncStream<AppState> {
        await base.stream(repeat each paths)
    }
}
