import Foundation

// MARK: KeyPath observation
public extension BaseStore {
    /// Emits the current state, then re-emits only when one of the
    /// watched keypaths' values changes. Variadic via parameter packs,
    /// so any number of fields can be observed in a single call.
    func stream<each Property: Equatable & Sendable>(
        _ paths: repeat KeyPath<State, each Property>
    ) -> AsyncStream<State> {
        AsyncStream { continuation in
            let task = Task {
                var prev: State?
                for await state in self.stateStream() {
                    defer { prev = state }
                    guard let prevState = prev else {
                        continuation.yield(state)
                        continue
                    }
                    var changed = false
                    func check<T: Equatable>(_ kp: KeyPath<State, T>) {
                        changed = changed || (state[keyPath: kp] != prevState[keyPath: kp])
                    }
                    _ = (repeat check(each paths))
                    guard changed else { continue }
                    continuation.yield(state)
                }
            }
            continuation.onTermination = { _ in task.cancel() }
        }
    }
}
