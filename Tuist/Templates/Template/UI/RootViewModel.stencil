import FactoryKit
import Foundation

@MainActor
final class RootViewModel: ObservableObject {
    @Injected(\.appStore) private var store
    @Injected(\.actionDispatcher) private var dispatcher

    @Published private(set) var isActive: Bool = false
    @Published private(set) var logs: [String] = []

    private var observationTask: Task<Void, Never>?

    func load() {
        observationTask?.cancel()
        observationTask = Task { [weak self] in
            // Watches two substate keypaths at once — the parameter-pack `stream(_:)` takes
            // any number of them.
            guard let stream = await self?.store.stream(\.isActive, \.log.entries) else { return }
            for await state in stream {
                // due to lack of @Observable
                await MainActor.run { [weak self] in
                    guard let self else { return }
                    self.isActive = state.isActive
                    self.logs = state.log.entries
                }
            }
        }
    }

    deinit {
        observationTask?.cancel()
    }

    func toggleActive() {
        let action = AppAction.setIsActive(!isActive)
        dispatcher.dispatch(action)
    }

    func addLog(_ log: String) {
        dispatcher.dispatch(LoggingAction.addEntry(log))
    }

    func resetLog() {
        dispatcher.dispatch(LoggingAction.clearEntries)
    }
}
